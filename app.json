{
  "expo": {
    "name": "keymachinesales.in",
    "slug": "key-mitra-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/keymitra-icon.png",
    "scheme": "keymitra",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.suriyakeys.keymitra",
      "supportsTablet": true,
      "icon": "./assets/images/keymitra-icon.png"
    },
    "android": {
      "package": "com.suriyakeys.main",
      "adaptiveIcon": {
        "backgroundColor": "#1D4656",
        "foregroundImage": "./assets/images/keymitra-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1D4656",
          "image": "./assets/images/keymitra-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Key Mitra administrators to add product photos.",
          "microphonePermission": false
        }
      ],
      "expo-image",
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "7d431604-1ac3-4390-852d-b1312e932872"
      }
    }
  }
}
